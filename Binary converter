#include <iostream>
using namespace std;

void decimalToBinary(int n) {
    int binary[32], *ptr = binary, i = 0;
    while (n > 0) {
        *(ptr + i) = n % 2;
        n /= 2;
        i++;
    }
    for (int j = i - 1; j >= 0; j--)
        cout << *(ptr + j);
}

int main() {
    int num;
    cout << "Enter a decimal number: ";
    cin >> num;
    decimalToBinary(num);
    return 0;
}
